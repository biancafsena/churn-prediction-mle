# ============================================================
models/*
*.joblib
*.pkl
*.pickle

!models/.gitkeep
!models/mlp_pytorch_metadata.json
!models/mlp_pytorch_preprocessor.joblib
!models/mlp_pytorch_state_dict.pt

# ============================================================
# Artefatos gerados
# ============================================================
artifacts/metrics/*
!artifacts/metrics/.gitkeep

artifacts/figures/*
!artifacts/figures/.gitkeep

